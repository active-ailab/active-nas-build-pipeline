# ═══════════════════════════════════════════════════════
# 固件发布流水线 — 环境变量配置模板
# 复制为 .env 后填入真实凭证（切勿把真实值提交进仓库）
# .env 已被 .gitignore 忽略，不会进入 git 仓库
# ═══════════════════════════════════════════════════════

# ── Jenkins ──
JENKINS_PASSWORD=CHANGE_ME

# ── NAS（WebDAV / DSM，内网 10.2.100.85）──
NAS_WEBDAV_PASSWORD=CHANGE_ME
NAS_DSM_PASSWORD=CHANGE_ME

# ── 飞书 ──
FEISHU_APP_ID=CHANGE_ME
FEISHU_APP_SECRET=CHANGE_ME
FEISHU_WEBHOOK_URL=CHANGE_ME

# ── DeepSeek（AI 意图识别，key 为空时读此变量）──
DEEPSEEK_API_KEY=CHANGE_ME

# ── 飞书用户 token（旧 OAuth 遗留，一般留空）──
FEISHU_USER_ACCESS_TOKEN=
FEISHU_USER_REFRESH_TOKEN=
